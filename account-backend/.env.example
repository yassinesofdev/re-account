APP_NAME="RE-Account"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8338

# Proxies whose X-Forwarded-* headers are trusted ('*' = any; behind the AWS ALB)
TRUSTED_PROXIES=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=re_account
DB_USERNAME=re_user
DB_PASSWORD=re_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

SANCTUM_STATEFUL_DOMAINS=localhost:3742,127.0.0.1:3742

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1026
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@re-account.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:3742

JWT_TTL=900
JWT_SECRET=change-me-64-char-random-secret

# Product sign-in callbacks + secrets, applied by `php artisan db:seed` (unset = local
# defaults http://localhost:3741/intelligence/auth/callback, http://localhost:3743/auth/callback and the dev secrets; set = also
# updates existing rows). Secrets must equal each product's RE_PRODUCT_SECRET.
# RE_INTEL_REDIRECT_URL=https://app.example.com/intelligence/auth/callback
# RE_INTEL_PRODUCT_SECRET=
# RE_DATA_REDIRECT_URL=https://data.example.com/auth/callback
# RE_DATA_PRODUCT_SECRET=

# Stripe billing (hosted Checkout + Customer Portal). Empty STRIPE_SECRET
# disables billing: billing endpoints return 503 billing_unavailable.
STRIPE_SECRET=
# whsec_… printed by `stripe listen --forward-to localhost:8338/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
# Most seats an org can take on a free org plan (paid plans: no cap).
FREE_ORG_MAX_SEATS=3
# Optional and unused (hosted Checkout needs no publishable key).
# STRIPE_KEY=
